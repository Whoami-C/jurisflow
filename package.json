{
  "name": "jurisflow-local",
  "version": "1.0.0",
  "private": true,
  "description": "CRM jurídico local com Next.js, NestJS, Prisma e PostgreSQL.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "local": "node scripts/run-local.mjs",
    "dev": "concurrently --kill-others -n WEB,API -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "next dev --port 3000",
    "dev:api": "nest start --watch",
    "build": "npm run build:web && npm run build:api",
    "build:web": "next build",
    "build:api": "nest build",
    "start:web": "next start --port 3000",
    "start:api": "node dist/backend/src/main.js",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "check": "npm run lint && npm test && npm run build",
    "db:generate": "prisma generate",
    "db:start": "node scripts/postgres-only.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.3",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.3",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "helmet": "8.1.0",
    "lucide-react": "1.31.0",
    "next": "16.3.4",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.0.7",
    "@nestjs/testing": "11.2.3",
    "@tailwindcss/postcss": "4.2.1",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.1",
    "@types/passport-jwt": "4.0.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "6.0.3",
    "concurrently": "9.2.1",
    "embedded-postgres": "17.9.0-beta.17",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.4",
    "jest": "30.2.0",
    "prisma": "6.19.3",
    "supertest": "7.2.2",
    "tailwindcss": "4.2.1",
    "ts-jest": "29.4.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1"
  },
  "overrides": {
    "multer": "2.3.0"
  }
}
